{
  "name": "@daily-loop/api",
  "version": "0.1.0",
  "private": true,
  "description": "daily-loop REST API (Node.js + Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "datasets:check": "tsx src/scripts/check-datasets.ts",
    "challenges:generate": "tsx src/scripts/generate.ts"
  },
  "dependencies": {
    "@daily-loop/shared": "^0.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
