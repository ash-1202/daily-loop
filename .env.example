# Copy to .env and adjust if needed:  cp .env.example .env
# These defaults match docker-compose.yml, so local development works without changes.

# API (the web dev server proxies /api to this port)
API_PORT=3000
DATABASE_URL=postgres://daily_loop:daily_loop@localhost:5433/daily_loop

# Email login (optional). Locally, codes are printed to the API's console; nothing is sent.
# EMAIL_PROVIDER=console        # console | resend | none
# RESEND_API_KEY=re_...         # production only
# EMAIL_FROM=Market Daily 5 <no-reply@mail.tradertrix.com>
# OTP_SECRET=...                # production only: 32+ random characters (openssl rand -hex 32)
